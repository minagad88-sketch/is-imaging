# Railway sets DATABASE_URL automatically once you add a PostgreSQL plugin
# to this project. You don't need to set it by hand on Railway — this file
# is just so you know it exists. For local testing, paste your own value.
DATABASE_URL=postgres://user:password@host:5432/railway

# If your Postgres provider requires SSL (Railway's usually doesn't need this
# for its own internal DB, but external/managed Postgres often does):
# PGSSL=true

# Credentials for the /admin panel (protects /api/admin/*).
# Pick your own values — these are NOT preset for you.
ADMIN_USER=change-me
ADMIN_PASS=change-me-too
